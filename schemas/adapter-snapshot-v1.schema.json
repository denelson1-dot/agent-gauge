{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agent-gauge.local/schemas/adapter-snapshot-v1.schema.json",
  "title": "Agent Gauge Adapter Snapshot V1",
  "type": "object",
  "required": ["schema_version", "status"],
  "properties": {
    "schema_version": { "const": 1 },
    "observed_at": { "type": "string", "format": "date-time" },
    "status": { "enum": ["connected", "waiting", "disconnected"] },
    "windows": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "label", "used_percent"],
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z0-9-]{1,64}$" },
          "label": { "type": "string", "minLength": 1 },
          "used_percent": { "type": "number", "minimum": 0, "maximum": 100 },
          "resets_at": { "type": "string", "format": "date-time" },
          "window_minutes": { "type": "integer", "minimum": 1 },
          "display": { "enum": ["ring", "bar"] }
        }
      }
    },
    "balances": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "label", "amount", "unit"],
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z0-9-]{1,64}$" },
          "label": { "type": "string", "minLength": 1 },
          "amount": { "type": "string", "pattern": "^-?[0-9]+(?:\\.[0-9]+)?$" },
          "unit": { "type": "string", "minLength": 1, "maxLength": 16 }
        }
      }
    }
  }
}
